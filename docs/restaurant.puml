@startuml cjm_restaurant
title CJM ресторана — интеграция с Avito.Кухня

|Ресторан|
start
:Регистрирует заведение:\nname, city, cuisine,\ncallback_url;

|API|
:POST /restaurants;
:Создаёт запись,\nгенерирует api_key;
:Возвращает Restaurant\n(id, api_key);

|Ресторан|
:Сохраняет api_key\nдля дальнейших запросов;

:Готовит список блюд\n(название, описание,\nцена);
|API|
:POST /menu;
:Создаёт MenuItem;

|Ресторан|
:Ожидает входящие заказы\n(POST на свой\ncallback_url);

|#LightSalmon|Клиент|
:Пользователь оформляет заказ;
|API|
:Проверяет закаказ;
:Вызывает callback_url\nресторана с деталями\nзаказа;

|Ресторан|
:Получает заказ\n(блюда, адрес,\nкомментарий);

if (Может принять заказ?) then (нет)
  :Отклоняет заказ;
  |API|
  :status → rejected;
  |Клиент|
  :Видит причину отказа;
  stop
else (да)
  |Ресторан|
  :Принимает заказ;
  |API|
  :status → confirmed;
  |Клиент|
  :Видит информацию\n о заказе;
endif

|Ресторан|
:Готовит и доставляет заказ;
:Обновляет статус;
|API|
:PATCH /orders/{id}/status;
|Клиент|
:Смотрит статус заказа;

stop

@enduml